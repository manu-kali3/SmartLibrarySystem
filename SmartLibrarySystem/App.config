<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NET Framework,Version=v4.7.2"/>
  </startup>
  <connectionStrings>
    <!--
      LocalDB (default): ships with Visual Studio and needs no database setup.
      The app creates LibraryDB, its tables and seed data automatically on first launch.

      To use a full/central SQL Server instead, replace the value with, e.g.:
      Server=.\SQLEXPRESS;Database=LibraryDB;Integrated Security=True;Trusted_Connection=True;
      Server=SERVERNAME\SQLEXPRESS;Database=LibraryDB;User ID=sa;Password=yourpass;
    -->
    <add name="LibraryDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=LibraryDB;Integrated Security=True;Encrypt=False;"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>